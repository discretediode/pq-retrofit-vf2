 rej:
@@ -151,11 +160,19 @@ rej:
   shake256_finalize(&state);
   shake256_squeeze(sig, CTILDEBYTES, &state);
   poly_challenge(&cp, sig);
+#ifdef ACCEL
+  /* c*s1 and c*s2 as exact small integers, computed by the accelerator */
